# Postgres connection string. When the Vercel Postgres (Neon) integration is
# added to this project, Vercel injects DATABASE_URL into every deployment and
# `vercel env pull` writes it here automatically — you should not need to set
# this by hand except for local development against a dev database.
DATABASE_URL=

# Resend API key (Dashboard → API Keys). Required to send confirmation emails.
RESEND_API_KEY=

# Must be on a domain verified in Resend (Dashboard → Domains). Until a domain
# is verified, use the sandbox sender "onboarding@resend.dev" — it only
# delivers to the email address on the Resend account itself, which is enough
# to test the flow end to end before going live.
RESEND_FROM_EMAIL="TheUrbanNet <onboarding@resend.dev>"

# Optional. The existing Google Apps Script web app that appends each
# submission to the Google Sheet (which feeds the Slides deck). Defaults to
# the URL the forms used to call directly, so this only needs setting if the
# script is ever redeployed under a new URL.
GOOGLE_SCRIPT_URL=
